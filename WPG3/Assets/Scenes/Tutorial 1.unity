  steps:
  - tutorialText: "Semua sudah beres\u2026 apa lagi ya?"
    uiToShow: {fileID: 1019774043}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 619625161}
    uiToHide1: {fileID: 555692744}
    uiToShow2: {fileID: 52911131}
    uiToHide2: {fileID: 0}
    uiToShow3: {fileID: 1226480514}
