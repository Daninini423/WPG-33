    - {fileID: 52911131}
  - tutorialText: "\u2026..?"
    uiToShow: {fileID: 0}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 619625161}
    uiToHide1: {fileID: 1562914463}
    uiToShow2: {fileID: 0}
    uiToHide2: {fileID: 0}
    uiToShow3: {fileID: 0}
