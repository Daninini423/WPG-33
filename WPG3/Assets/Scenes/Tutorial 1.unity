    hidePanel: 0
    stepSound: {fileID: 0}
    uiToFront: []
  - tutorialText: Istiraha Katamu...?
    uiToShow: {fileID: 555692744}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 1562914463}
    uiToHide1: {fileID: 619625161}
    uiToShow2: {fileID: 52911131}
    uiToHide2: {fileID: 0}
    uiToShow3: {fileID: 0}
    uiToHide3: {fileID: 0}
    characterExpression1: {fileID: 0}
