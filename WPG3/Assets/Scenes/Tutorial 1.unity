    - {fileID: 1019774043}
    - {fileID: 1064357091}
    - {fileID: 619625161}
    - {fileID: 52911131}
  - tutorialText: Kamu lagi? Ngapain ke sini?
    uiToShow: {fileID: 0}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 0}
    uiToHide1: {fileID: 0}
    uiToShow2: {fileID: 0}
    uiToHide2: {fileID: 0}
    uiToShow3: {fileID: 0}
    uiToHide3: {fileID: 0}
    characterExpression1: {fileID: 21300000, guid: b12adad9b98ca7047a7080a186afaa0c, type: 3}
    characterExpression2: {fileID: 0}
    hidePanel: 0
    stepSound: {fileID: 0}
    uiToFront: []
  - tutorialText: Aku tak akan berhenti sampai dapat kekuatan Pohon Agung!
    uiToShow: {fileID: 0}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 1562914463}
    uiToHide1: {fileID: 619625161}
