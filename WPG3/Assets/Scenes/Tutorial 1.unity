    - {fileID: 1064357091}
    - {fileID: 619625161}
  - tutorialText: "Istirahat dulu deh\u2026"
    uiToShow: {fileID: 0}
    uiToHide: {fileID: 0}
    uiToShow1: {fileID: 0}
    uiToHide1: {fileID: 0}
    uiToShow2: {fileID: 0}
    uiToHide2: {fileID: 0}
